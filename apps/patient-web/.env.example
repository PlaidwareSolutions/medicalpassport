# Patient PWA environment (docs/28).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Cloudflare Turnstile (docs/26 §12.4) — the widget's public site key (not
# secret, safe client-side). Optional: the login screen renders no widget
# without it, matching the API's TURNSTILE_SECRET_KEY being optional too.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
