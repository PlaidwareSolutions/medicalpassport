# Cron jobs environment (docs/25). Copy to .env for local development.
NODE_ENV=development

# PostgreSQL (Railway private networking in deployed environments)
DATABASE_URL=postgresql://medpass:medpass@localhost:5432/medpass

# Needed by cleanup-abandoned-uploads (must match the api service's value).
FIELD_ENCRYPTION_KEY=ZGV2LWZpZWxkLWtleS1jaGFuZ2UtbWUtMzJieXRlcyE=
# OBJECT_STORAGE_ROOT=.dev-data/object-storage

# Needed by detect-due-reminders to send web push (docs/16). Must match the
# api service's VAPID keypair — generate with:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@example.com

# Needed by detect-due-reminders to send SMS reminders (docs/16, OD-10).
# Must match the api service's Telnyx credentials.
# TELNYX_API_KEY=
# TELNYX_FROM_NUMBER=
