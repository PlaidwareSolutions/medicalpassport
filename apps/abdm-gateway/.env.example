# ABDM gateway service (docs_v2/08 §4, §9; ADR-V2-005). Copy to .env for local development.
NODE_ENV=development
PORT=4100
DATABASE_URL=postgresql://medpass:medpass@localhost:5432/medpass

# Shared secret the API sends as `x-abdm-internal-token` on every /internal/* call.
ABDM_INTERNAL_TOKEN=dev-abdm-internal-token-change-me
# mock | sandbox | production — stamped on every AbdmTransaction.
ABDM_GATEWAY_ENV=mock

# MOCK=true replays the recorded fixtures under ./fixtures instead of calling ABDM
# (docs_v2/08 §9 "local"); refused in production.
MOCK=true

# Callback JWT verification. HS256 for the mock / early sandbox; set the RS256
# public key (PEM) once the gateway publishes its signing key.
ABDM_GATEWAY_JWT_HS256_SECRET=dev-abdm-gateway-jwt-secret-change-me
# ABDM_GATEWAY_JWT_RS256_PUBLIC_KEY=
# ABDM_GATEWAY_JWT_ISSUER=
# ABDM_GATEWAY_JWT_AUDIENCE=

# Outbound ABDM gateway credentials (sandbox / production only; unused when MOCK=true).
# ABDM_BASE_URL=https://dev.abdm.gov.in/gateway
# ABDM_CLIENT_ID=
# ABDM_CLIENT_SECRET=
# ABDM_HIU_ID=
# ABDM_HIP_ID=
