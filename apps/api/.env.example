# API service environment (docs/28). Copy to .env for local development.
NODE_ENV=development
PORT=4000

# PostgreSQL (Railway private networking in deployed environments)
DATABASE_URL=postgresql://medpass:medpass@localhost:5432/medpass

# Peppers / keys — generate real values per environment; never commit them.
OTP_HASH_PEPPER=dev-otp-pepper-change-me
SESSION_TOKEN_PEPPER=dev-session-pepper-change-me
FIELD_ENCRYPTION_KEY=ZGV2LWZpZWxkLWtleS1jaGFuZ2UtbWUtMzJieXRlcyE=

# OTP transport: "log" is dev-only (API refuses it in production).
OTP_TRANSPORT=log
OTP_DEV_FIXED_CODE=000000

# Optional
# REDIS_URL=redis://localhost:6379
# ALLOWED_HOSTS=api.example.com
# CORS_ORIGINS=http://localhost:3000
# OBJECT_STORAGE_ROOT=.dev-data/object-storage

# Web push (docs/16) — self-signed VAPID keypair, no external provider
# needed. Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@example.com

# SMS (docs/16, OD-10) — Telnyx. Required for OTP_TRANSPORT=sms and for any
# SMS reminder channel to dispatch. TELNYX_FROM_NUMBER must be a number (or
# a number backed by a messaging profile) that is (a) toll-free-verified or
# a registered long code, and (b) whose messaging profile's whitelisted
# destinations include the countries you'll actually send to — neither is
# true of a freshly-provisioned US number by default, and India additionally
# requires DLT/TRAI sender registration regardless of Telnyx-side config.
# TELNYX_API_KEY=
# TELNYX_FROM_NUMBER=

# Telnyx delivery-status webhook (docs/16 follow-up). TELNYX_PUBLIC_KEY is
# from the Telnyx portal (Account Settings > Public Key), NOT the API key —
# also fetchable via `GET /v2/public_key`. TELNYX_WEBHOOK_URL is this API's
# full public webhook URL (must be reachable from the internet, so it's
# unset until a real domain exists — OD-1); without it SMS still sends, it
# just never learns whether the message was actually delivered.
# TELNYX_PUBLIC_KEY=
# TELNYX_WEBHOOK_URL=https://api.example.com/v1/webhooks/telnyx/sms
