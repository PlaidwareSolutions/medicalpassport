{
  "name": "@medpass/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch & node --watch dist/main.js",
    "start": "node dist/main.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "openapi:generate": "tsc -p tsconfig.json && node dist/openapi/generate.js",
    "openapi:check": "tsc -p tsconfig.json && node dist/openapi/check.js"
  },
  "dependencies": {
    "@medpass/audit": "workspace:*",
    "@medpass/authorization": "workspace:*",
    "@medpass/clinical-rules": "workspace:*",
    "@medpass/config": "workspace:*",
    "@medpass/database": "workspace:*",
    "@medpass/document-intelligence": "workspace:*",
    "@medpass/domain": "workspace:*",
    "@medpass/field-crypto": "workspace:*",
    "@medpass/health-events": "workspace:*",
    "@medpass/medication-terminology": "workspace:*",
    "@medpass/notifications": "workspace:*",
    "@medpass/object-storage": "workspace:*",
    "@medpass/observability": "workspace:*",
    "@medpass/offline-sync": "workspace:*",
    "@medpass/provenance": "workspace:*",
    "@medpass/terminology": "workspace:*",
    "@medpass/validation": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "11.4.7",
    "cookie-parser": "^1.4.7",
    "otpauth": "^9.3.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "10.1.1",
    "@nestjs/testing": "^11.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/diff": "7.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "diff": "7.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
