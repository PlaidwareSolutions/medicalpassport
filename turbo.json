{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NODE_ENV", "NEXT_PUBLIC_API_URL"]
    },
    "generate": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["build", "^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "OTP_DEV_FIXED_CODE",
        "OTP_HASH_PEPPER",
        "SESSION_TOKEN_PEPPER",
        "FIELD_ENCRYPTION_KEY",
        "OTP_TRANSPORT",
        "PORT"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
