  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prisma": "^6.2.1",
    "typescript": "^5.7.2"
  }
