// Stage 2 subset of the full data model (docs/13-data-model.md).
// Conventions: uuid PKs, timestamptz, soft delete via deletedAt, original vs
// normalized values in separate columns, no PHI in identifiers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- identity & access ----------

enum UserStatus {
  active
  suspended
  deletion_pending
  deleted
}

model User {
  id String @id @default(uuid()) @db.Uuid

  /// HMAC digest of the E.164 phone — used for lookup/uniqueness.
  phoneDigest     String @unique @map("phone_digest")
  /// AES-256-GCM ciphertext of the E.164 phone (application-level encryption).
  phoneCiphertext String @map("phone_ciphertext")

  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  email           String?
  preferredLocale String     @default("en") @map("preferred_locale")
  status          UserStatus @default(active)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  devices                UserDevice[]
  sessions               Session[]
  ownedProfiles          PatientProfile[]        @relation("ProfileOwner")
  claimedProfiles        PatientProfile[]        @relation("ProfileClaimer")
  caregiverRelationships CaregiverRelationship[] @relation("CaregiverUser")
  notificationChannels   NotificationChannel[]

  @@map("users")
}

enum DeviceKind {
  browser
  android
  ios
}

model UserDevice {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String     @map("user_id") @db.Uuid
  user            User       @relation(fields: [userId], references: [id])
  kind            DeviceKind @default(browser)
  label           String?
  userAgentDigest String?    @map("user_agent_digest")
  lastSeenAt      DateTime   @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt       DateTime?  @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  sessions Session[]

  @@index([userId, lastSeenAt])
  @@map("user_devices")
}

model Session {
  id               String     @id @default(uuid()) @db.Uuid
  userId           String     @map("user_id") @db.Uuid
  user             User       @relation(fields: [userId], references: [id])
  userDeviceId     String     @map("user_device_id") @db.Uuid
  userDevice       UserDevice @relation(fields: [userDeviceId], references: [id])
  /// SHA-256(pepper + token). Raw tokens are never stored.
  tokenHash        String     @unique @map("token_hash")
  refreshTokenHash String     @unique @map("refresh_token_hash")
  expiresAt        DateTime   @map("expires_at") @db.Timestamptz(6)
  refreshExpiresAt DateTime   @map("refresh_expires_at") @db.Timestamptz(6)
  revokedAt        DateTime?  @map("revoked_at") @db.Timestamptz(6)
  revokeReason     String?    @map("revoke_reason")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, revokedAt])
  @@map("sessions")
}

enum OtpPurpose {
  login
  recovery
  share_verification
}

model OtpAttempt {
  id String @id @default(uuid()) @db.Uuid

  /// HMAC digest of the phone; the raw number is not stored on this table.
  phoneDigest String     @map("phone_digest")
  /// scrypt(pepper + code). OTP codes are never stored in plaintext.
  otpHash     String     @map("otp_hash")
  purpose     OtpPurpose @default(login)

  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(6)
  invalidatedAt  DateTime? @map("invalidated_at") @db.Timestamptz(6)
  verifyAttempts Int       @default(0) @map("verify_attempts")
  sentCount      Int       @default(1) @map("sent_count")
  lastSentAt     DateTime  @default(now()) @map("last_sent_at") @db.Timestamptz(6)
  ipDigest       String?   @map("ip_digest")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phoneDigest, createdAt])
  @@map("otp_attempts")
}

// ---------- profiles, caregivers, consent ----------

enum Sex {
  female
  male
  other
  undisclosed
}

model PatientProfile {
  id              String  @id @default(uuid()) @db.Uuid
  ownerUserId     String  @map("owner_user_id") @db.Uuid
  ownerUser       User    @relation("ProfileOwner", fields: [ownerUserId], references: [id])
  claimedByUserId String? @map("claimed_by_user_id") @db.Uuid
  claimedByUser   User?   @relation("ProfileClaimer", fields: [claimedByUserId], references: [id])

  displayName     String @map("display_name")
  yearOfBirth     Int?   @map("year_of_birth") @db.SmallInt
  sex             Sex?
  preferredLocale String @default("en") @map("preferred_locale")
  emergencyCard   Json?  @map("emergency_card")

  rowVersion Int       @default(0) @map("row_version")
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  caregiverRelationships CaregiverRelationship[]
  consents               Consent[]
  allergies              PatientAllergy[]
  conditions             PatientCondition[]
  medications            PatientMedication[]
  practitioners          Practitioner[]
  safetyEvaluations      SafetyEvaluation[]
  sharePackages          SharePackage[]
  prescriptionDocuments  PrescriptionDocument[]
  notifications          Notification[]
  notificationPreference NotificationPreference?

  @@index([ownerUserId])
  @@map("patient_profiles")
}

enum RelationshipStatus {
  invited
  active
  revoked
  expired
}

model CaregiverRelationship {
  id               String         @id @default(uuid()) @db.Uuid
  patientProfileId String         @map("patient_profile_id") @db.Uuid
  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id])
  /// Null until the invited person accepts with their own account.
  caregiverUserId  String?        @map("caregiver_user_id") @db.Uuid
  caregiverUser    User?          @relation("CaregiverUser", fields: [caregiverUserId], references: [id])

  invitedPhoneDigest String             @map("invited_phone_digest")
  relationship       String
  status             RelationshipStatus @default(invited)
  acceptedAt         DateTime?          @map("accepted_at") @db.Timestamptz(6)
  expiresAt          DateTime?          @map("expires_at") @db.Timestamptz(6)
  revokedAt          DateTime?          @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId    String?            @map("revoked_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions CaregiverPermission[]

  @@index([patientProfileId, status])
  @@index([caregiverUserId, status])
  @@map("caregiver_relationships")
}

enum CaregiverScope {
  view_medications
  view_schedule
  manage_reminders
  record_doses
  add_medications
  edit_medications
  review_concerns
  share_records
  manage_profile
  full_management
}

model CaregiverPermission {
  id                      String                @id @default(uuid()) @db.Uuid
  caregiverRelationshipId String                @map("caregiver_relationship_id") @db.Uuid
  caregiverRelationship   CaregiverRelationship @relation(fields: [caregiverRelationshipId], references: [id])
  scope                   CaregiverScope
  grantedAt               DateTime              @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedByUserId         String                @map("granted_by_user_id") @db.Uuid
  revokedAt               DateTime?             @map("revoked_at") @db.Timestamptz(6)

  @@unique([caregiverRelationshipId, scope])
  @@map("caregiver_permissions")
}

enum ConsentType {
  data_processing
  sms_reminders
  whatsapp_reminders
  email
  caregiver_access
  sharing
  ai_processing
  emergency_card
}

enum ConsentStatus {
  active
  revoked
  expired
}

model Consent {
  id               String         @id @default(uuid()) @db.Uuid
  patientProfileId String         @map("patient_profile_id") @db.Uuid
  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id])
  type             ConsentType
  purpose          String
  scope            Json?
  status           ConsentStatus  @default(active)
  grantedAt        DateTime       @default(now()) @map("granted_at") @db.Timestamptz(6)
  expiresAt        DateTime?      @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime?      @map("revoked_at") @db.Timestamptz(6)

  events ConsentEvent[]

  @@index([patientProfileId, type, status])
  @@map("consents")
}

model ConsentEvent {
  id          String   @id @default(uuid()) @db.Uuid
  consentId   String   @map("consent_id") @db.Uuid
  consent     Consent  @relation(fields: [consentId], references: [id])
  event       String
  actorUserId String?  @map("actor_user_id") @db.Uuid
  context     Json?
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([consentId, occurredAt])
  @@map("consent_events")
}

/// Patient-scoped prescriber records (MVP). A verified global directory can
/// supersede these later (docs/13).
model Practitioner {
  id                 String          @id @default(uuid()) @db.Uuid
  createdByProfileId String?         @map("created_by_profile_id") @db.Uuid
  createdByProfile   PatientProfile? @relation(fields: [createdByProfileId], references: [id])
  displayName        String          @map("display_name")
  speciality         String?
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  medications PatientMedication[]

  @@map("practitioners")
}

enum AllergySeverity {
  mild
  moderate
  severe
  unknown
}

enum RecordSource {
  patient
  document
  professional
}

model PatientAllergy {
  id                   String                @id @default(uuid()) @db.Uuid
  patientProfileId     String                @map("patient_profile_id") @db.Uuid
  patientProfile       PatientProfile        @relation(fields: [patientProfileId], references: [id])
  label                String
  allergenIngredientId String?               @map("allergen_ingredient_id") @db.Uuid
  allergenIngredient   MedicationIngredient? @relation(fields: [allergenIngredientId], references: [id])
  severity             AllergySeverity       @default(unknown)
  reactionNote         String?               @map("reaction_note")
  source               RecordSource          @default(patient)
  active               Boolean               @default(true)
  recordedByUserId     String                @map("recorded_by_user_id") @db.Uuid
  deletedAt            DateTime?             @map("deleted_at") @db.Timestamptz(6)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([patientProfileId])
  @@map("patient_allergies")
}

model PatientCondition {
  id               String         @id @default(uuid()) @db.Uuid
  patientProfileId String         @map("patient_profile_id") @db.Uuid
  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id])
  label            String
  note             String?
  source           RecordSource   @default(patient)
  active           Boolean        @default(true)
  recordedByUserId String         @map("recorded_by_user_id") @db.Uuid
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([patientProfileId])
  @@map("patient_conditions")
}

// ---------- medication catalog (non-PHI, admin-owned) ----------

enum CatalogStatus {
  active
  deprecated
  banned
}

model MedicationIngredient {
  id       String        @id @default(uuid()) @db.Uuid
  name     String        @unique
  synonyms String[]      @default([])
  status   CatalogStatus @default(active)

  productIngredients MedicationProductIngredient[]
  allergies          PatientAllergy[]

  @@map("medication_ingredients")
}

model Manufacturer {
  id     String        @id @default(uuid()) @db.Uuid
  name   String        @unique
  status CatalogStatus @default(active)

  brands MedicationBrand[]

  @@map("manufacturers")
}

model MedicationBrand {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  aliases        String[]      @default([])
  manufacturerId String?       @map("manufacturer_id") @db.Uuid
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id])
  status         CatalogStatus @default(active)

  products MedicationProduct[]

  @@index([name])
  @@map("medication_brands")
}

model DosageForm {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  products MedicationProduct[]

  @@map("dosage_forms")
}

model AdministrationRoute {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  products MedicationProduct[]

  @@map("administration_routes")
}

model TherapeuticClass {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  parentId String? @map("parent_id") @db.Uuid

  classifications ProductClassification[]

  @@map("therapeutic_classes")
}

enum ReleaseType {
  immediate
  sustained
  extended
  controlled
  unspecified
}

model MedicationProduct {
  id            String               @id @default(uuid()) @db.Uuid
  brandId       String?              @map("brand_id") @db.Uuid
  brand         MedicationBrand?     @relation(fields: [brandId], references: [id])
  genericName   String               @map("generic_name")
  dosageFormId  String?              @map("dosage_form_id") @db.Uuid
  dosageForm    DosageForm?          @relation(fields: [dosageFormId], references: [id])
  routeId       String?              @map("route_id") @db.Uuid
  route         AdministrationRoute? @relation(fields: [routeId], references: [id])
  releaseType   ReleaseType          @default(unspecified) @map("release_type")
  isCombination Boolean              @default(false) @map("is_combination")
  /// Human-readable strength summary, e.g. "500 mg".
  strengthLabel String?              @map("strength_label")
  regulatoryRef String?              @map("regulatory_ref")
  /// Source registry entry + version this product row came from (docs/11).
  sourceName    String?              @map("source_name")
  sourceVersion String?              @map("source_version")
  status        CatalogStatus        @default(active)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  ingredients     MedicationProductIngredient[]
  classifications ProductClassification[]
  medications     PatientMedication[]

  @@index([genericName])
  @@map("medication_products")
}

model MedicationProductIngredient {
  id            String               @id @default(uuid()) @db.Uuid
  productId     String               @map("product_id") @db.Uuid
  product       MedicationProduct    @relation(fields: [productId], references: [id])
  ingredientId  String               @map("ingredient_id") @db.Uuid
  ingredient    MedicationIngredient @relation(fields: [ingredientId], references: [id])
  strengthValue Decimal?             @map("strength_value") @db.Decimal(10, 3)
  strengthUnit  String?              @map("strength_unit")

  @@unique([productId, ingredientId])
  @@map("medication_product_ingredients")
}

model ProductClassification {
  id        String            @id @default(uuid()) @db.Uuid
  productId String            @map("product_id") @db.Uuid
  product   MedicationProduct @relation(fields: [productId], references: [id])
  classId   String            @map("class_id") @db.Uuid
  class     TherapeuticClass  @relation(fields: [classId], references: [id])
  source    String?

  @@unique([productId, classId])
  @@map("product_classifications")
}

// ---------- patient medications ----------

enum MedicationStatus {
  current
  paused
  completed
  stopped
  unknown
}

enum NormalizationStatus {
  unmatched
  candidate
  confirmed
}

enum MedicationSource {
  search
  manual
  extraction
  previous
  import
}

model PatientMedication {
  id               String         @id @default(uuid()) @db.Uuid
  patientProfileId String         @map("patient_profile_id") @db.Uuid
  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id])

  productId           String?             @map("product_id") @db.Uuid
  product             MedicationProduct?  @relation(fields: [productId], references: [id])
  /// Original entered/captured name — immutable, kept separate from
  /// normalization (docs/13 conventions).
  enteredName         String              @map("entered_name")
  normalizationStatus NormalizationStatus @default(unmatched) @map("normalization_status")

  /// Patient-specific reason as recorded — never inferred from common uses.
  patientReason  String?       @map("patient_reason")
  practitionerId String?       @map("practitioner_id") @db.Uuid
  practitioner   Practitioner? @relation(fields: [practitionerId], references: [id])

  source          MedicationSource
  status          MedicationStatus @default(current)
  statusChangedAt DateTime         @default(now()) @map("status_changed_at") @db.Timestamptz(6)
  statusReason    String?          @map("status_reason")
  startDate       DateTime?        @map("start_date") @db.Date
  endDate         DateTime?        @map("end_date") @db.Date
  isPrn           Boolean          @default(false) @map("is_prn")
  /// Patient-entered snapshot, auto-decremented on each "taken" dose event
  /// (docs/07 screen 27) — null means the patient hasn't opted into refill
  /// tracking for this medicine. Never inferred; only ever set by the
  /// patient (add/edit) or the mark-refilled action.
  quantityOnHand  Decimal?         @map("quantity_on_hand") @db.Decimal(8, 2)
  /// Patient opt-in only (docs/16 "opt-in policy") — never an inferred
  /// clinical judgement of severity. When true, a missed dose of this
  /// medicine escalates to caregivers immediately, bypassing quiet hours.
  criticalEscalation Boolean       @default(false) @map("critical_escalation")

  rowVersion Int       @default(0) @map("row_version")
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  instructions  MedicationInstruction[]
  changes       MedicationChange[]
  schedule      MedicationSchedule?
  doseEvents    DoseEvent[]
  notifications Notification[]

  @@index([patientProfileId, status])
  @@map("patient_medications")
}

enum FrequencyCode {
  OD
  BD
  TDS
  QID
  SOS
  HS
  PATTERN
  ALTERNATE_DAY
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  CUSTOM
}

enum FoodInstruction {
  before
  with
  after
  any
  bedtime
}

model MedicationInstruction {
  id                  String            @id @default(uuid()) @db.Uuid
  patientMedicationId String            @map("patient_medication_id") @db.Uuid
  patientMedication   PatientMedication @relation(fields: [patientMedicationId], references: [id])

  doseQuantity    Decimal         @map("dose_quantity") @db.Decimal(6, 2)
  doseUnit        String          @map("dose_unit")
  frequencyCode   FrequencyCode   @map("frequency_code")
  pattern         String?
  foodInstruction FoodInstruction @default(any) @map("food_instruction")
  durationDays    Int?            @map("duration_days")
  /// Original captured text (OCR / shorthand), preserved verbatim.
  originalText    String?         @map("original_text")

  confirmedByUserId String    @map("confirmed_by_user_id") @db.Uuid
  confirmedAt       DateTime  @default(now()) @map("confirmed_at") @db.Timestamptz(6)
  /// Latest instruction wins; superseded rows keep history.
  supersededAt      DateTime? @map("superseded_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([patientMedicationId, supersededAt])
  @@map("medication_instructions")
}

/// Append-only change log per medication (docs/13).
model MedicationChange {
  id                  String            @id @default(uuid()) @db.Uuid
  patientMedicationId String            @map("patient_medication_id") @db.Uuid
  patientMedication   PatientMedication @relation(fields: [patientMedicationId], references: [id])
  change              String
  detail              Json?
  actorUserId         String            @map("actor_user_id") @db.Uuid
  occurredAt          DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([patientMedicationId, occurredAt])
  @@map("medication_changes")
}

// ---------- scheduling & dose events (Stage 4 subset of docs/13) ----------

enum ScheduleRecurrence {
  daily
  weekly
  fortnightly
  monthly
  // alternate_day, taper, custom deferred to a later pass — frequency
  // codes that need them (ALTERNATE_DAY, QID, CUSTOM) are never
  // auto-scheduled (docs/09 §6).
}

enum ScheduleStatus {
  active
  paused
  ended
}

/// Executable schedule derived from a confirmed instruction (docs/13).
/// One per medication; only created for auto-schedulable frequency codes
/// (OD/BD/TDS/HS/PATTERN/WEEKLY/FORTNIGHTLY/MONTHLY) — QID/SOS/ALTERNATE_DAY/
/// CUSTOM require explicit patient setup and are never silently scheduled.
model MedicationSchedule {
  id                  String            @id @default(uuid()) @db.Uuid
  patientMedicationId String            @unique @map("patient_medication_id") @db.Uuid
  patientMedication   PatientMedication @relation(fields: [patientMedicationId], references: [id])

  /// Fixed for this MVP pass (docs/16 simplification note); per-profile
  /// timezone handling is future work.
  timezone   String             @default("Asia/Kolkata")
  /// [{ slot: "morning"|"midday"|"night", time: "08:00", quantity: 1 }, ...]
  slots      Json
  recurrence ScheduleRecurrence @default(daily)
  /// Reference date for weekly/fortnightly/monthly recurrence — the
  /// medication's own startDate (day-of-week for weekly/fortnightly,
  /// day-of-month for monthly, clamped at month end). Null for daily.
  anchorDate DateTime?          @map("anchor_date") @db.Date
  status     ScheduleStatus     @default(active)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  scheduledDoses ScheduledDose[]

  @@map("medication_schedules")
}

enum DoseStatus {
  upcoming
  taken
  skipped
  missed
  snoozed
  could_not_take
  unavailable
  problem
  taken_other_time
  cancelled
}

/// Materialized due dose (docs/13). Generated at instruction-confirm time
/// for a rolling window and extended by a cron job thereafter.
model ScheduledDose {
  id                   String             @id @default(uuid()) @db.Uuid
  medicationScheduleId String             @map("medication_schedule_id") @db.Uuid
  medicationSchedule   MedicationSchedule @relation(fields: [medicationScheduleId], references: [id])

  dueAt        DateTime   @map("due_at") @db.Timestamptz(6)
  slotLabel    String     @map("slot_label")
  quantity     Decimal    @db.Decimal(6, 2)
  status       DoseStatus @default(upcoming)
  /// Set when snoozed; the dose counts as due again once this passes.
  snoozedUntil DateTime?  @map("snoozed_until") @db.Timestamptz(6)

  rowVersion Int      @default(0) @map("row_version")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Bumped on every status change — including cron-driven ones (missed-dose
  /// reconciliation, snooze expiry) that carry no DoseEvent of their own —
  /// so incremental sync (docs/15) can detect "this dose changed" even when
  /// no explicit patient/caregiver action caused it.
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  doseEvents    DoseEvent[]
  notifications Notification[]

  @@unique([medicationScheduleId, dueAt])
  @@index([dueAt, status])
  @@index([updatedAt])
  @@map("scheduled_doses")
}

enum DoseAction {
  taken
  skipped
  snoozed
  could_not_take
  unavailable
  problem
  taken_other_time
  cancelled
}

/// Append-only record of what actually happened (docs/13). PRN doses carry
/// no scheduledDoseId.
model DoseEvent {
  id              String         @id @default(uuid()) @db.Uuid
  scheduledDoseId String?        @map("scheduled_dose_id") @db.Uuid
  scheduledDose   ScheduledDose? @relation(fields: [scheduledDoseId], references: [id])

  patientMedicationId String            @map("patient_medication_id") @db.Uuid
  patientMedication   PatientMedication @relation(fields: [patientMedicationId], references: [id])

  action           DoseAction
  recordedByUserId String     @map("recorded_by_user_id") @db.Uuid
  recordedAt       DateTime   @default(now()) @map("recorded_at") @db.Timestamptz(6)
  effectiveAt      DateTime   @map("effective_at") @db.Timestamptz(6)
  /// Offline idempotency key (docs/15) — retries of the same client
  /// mutation resolve to one event.
  clientMutationId String?    @unique @map("client_mutation_id") @db.Uuid
  channel          String     @default("pwa")

  @@index([patientMedicationId, recordedAt])
  @@map("dose_events")
}

// ---------- notifications (Stage 4 subset of docs/13) ----------
//
// Scope this pass (docs/22): web push only. SMS/WhatsApp/email/caregiver
// channels, quiet hours, and escalation are documented in docs/16 but
// deferred — SMS/WhatsApp are blocked on a provider decision (OD-10);
// email/caregiver channels and escalation are simply not built yet. Web
// push needs no external provider (self-signed VAPID keys), so it's the
// one channel implemented here; the schema still uses the full docs/13
// enums so adding a channel later is additive, not a redesign.

enum NotificationChannelKind {
  in_app
  web_push
  sms
  whatsapp
  email
  caregiver
}

enum NotificationChannelStatus {
  active
  paused
  failed
  revoked
}

/// Per-user push subscription (docs/13 notification_channels). Scoped to the
/// user, not a profile — one browser subscription can carry reminders for
/// every profile that user owns.
model NotificationChannel {
  id                String                    @id @default(uuid()) @db.Uuid
  userId            String                    @map("user_id") @db.Uuid
  user              User                      @relation(fields: [userId], references: [id])
  channel           NotificationChannelKind   @default(web_push)
  /// Encrypted JSON (docs/18): the web-push subscription object
  /// ({endpoint, keys:{p256dh,auth}}). Never stored in the clear.
  addressCiphertext String                    @map("address_ciphertext")
  /// Non-secret hash of the endpoint — lets a re-subscribe replace the old
  /// row without decrypting anything first.
  endpointDigest    String                    @unique @map("endpoint_digest")
  status            NotificationChannelStatus @default(active)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  attempts NotificationAttempt[]

  @@index([userId])
  @@map("notification_channels")
}

enum NotificationKind {
  dose_reminder
  refill
  completion
  missed_dose
  safety_finding
  caregiver_escalation
  system
}

/// Never expose the medicine name by default (docs/16) — patients opt in
/// explicitly. `standard`/`custom` wording variants are documented but not
/// built this pass.
enum NotificationPrivacyMode {
  generic
  full_name
}

enum NotificationStatus {
  pending
  dispatching
  done
  cancelled
}

/// One logical reminder (docs/13). `dedupeKey` is what makes the
/// every-minute detection cron safe to replay.
model Notification {
  id                  String                  @id @default(uuid()) @db.Uuid
  patientProfileId    String                  @map("patient_profile_id") @db.Uuid
  patientProfile      PatientProfile          @relation(fields: [patientProfileId], references: [id])
  kind                NotificationKind        @default(dose_reminder)
  scheduledDoseId     String?                 @map("scheduled_dose_id") @db.Uuid
  scheduledDose       ScheduledDose?          @relation(fields: [scheduledDoseId], references: [id])
  /// Set for `refill`/`completion` kinds (docs/07 screen 27) and for
  /// `caregiver_escalation` (alongside scheduledDoseId, to look up the
  /// medicine's criticalEscalation bypass flag at dispatch time) —
  /// dose_reminder notifications reach their medication via scheduledDose
  /// alone.
  patientMedicationId String?                 @map("patient_medication_id") @db.Uuid
  patientMedication   PatientMedication?      @relation(fields: [patientMedicationId], references: [id])
  privacyMode         NotificationPrivacyMode @default(generic) @map("privacy_mode")
  dedupeKey           String                  @unique @map("dedupe_key")
  status              NotificationStatus      @default(pending)
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  attempts NotificationAttempt[]

  @@map("notifications")
}

enum NotificationAttemptStatus {
  queued
  sent
  delivered
  failed
  retried
  acknowledged
  snoozed
  ignored
  escalated
}

/// Delivery truth table (docs/13) — a notification existing is never
/// confused with it having actually reached the patient.
model NotificationAttempt {
  id                    String                    @id @default(uuid()) @db.Uuid
  notificationId        String                    @map("notification_id") @db.Uuid
  notification          Notification              @relation(fields: [notificationId], references: [id])
  notificationChannelId String?                   @map("notification_channel_id") @db.Uuid
  notificationChannel   NotificationChannel?      @relation(fields: [notificationChannelId], references: [id])
  channel               NotificationChannelKind
  status                NotificationAttemptStatus @default(queued)
  errorDigest           String?                   @map("error_digest")
  /// Provider-side send id (Telnyx message id) — correlates a later
  /// delivery-status webhook back to this attempt. Null for web push (no
  /// provider message id) and for sends made before this field existed.
  providerMessageId     String?                   @map("provider_message_id")
  attemptedAt           DateTime                  @default(now()) @map("attempted_at") @db.Timestamptz(6)
  statusAt              DateTime                  @default(now()) @map("status_at") @db.Timestamptz(6)

  @@index([notificationId])
  @@index([providerMessageId])
  @@map("notification_attempts")
}

/// Per-profile reminder settings (docs/13). Push is opt-in (`false` default)
/// and wording defaults to the privacy-safe generic option.
model NotificationPreference {
  id                String                  @id @default(uuid()) @db.Uuid
  patientProfileId  String                  @unique @map("patient_profile_id") @db.Uuid
  patientProfile    PatientProfile          @relation(fields: [patientProfileId], references: [id])
  pushEnabled       Boolean                 @default(false) @map("push_enabled")
  privacyMode       NotificationPrivacyMode @default(generic) @map("privacy_mode")
  /// Docs/16: quiet hours respected except critical caregiver escalation
  /// (that carve-out isn't built — every push is deferred, no exceptions).
  /// Window may wrap midnight (e.g. 22:00-07:00); fixed Asia/Kolkata offset,
  /// matching the scheduling engine's existing simplification.
  quietHoursEnabled Boolean                 @default(true) @map("quiet_hours_enabled")
  quietHoursStart   String                  @default("22:00") @map("quiet_hours_start")
  quietHoursEnd     String                  @default("07:00") @map("quiet_hours_end")
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("notification_preferences")
}

// ---------- safety review (Stage 6 subset of docs/13) ----------
//
// Scope this pass (docs/22): exact/partial ingredient duplication,
// therapeutic-class duplication, drug-allergy, and uncertain-normalization
// findings — all derivable from our own catalog data. Drug-drug interaction,
// drug-condition, food, and alcohol checks need a licensed data source
// (OD-4) or clinically-reviewed content that doesn't exist yet, so those
// categories are not evaluated here (never fabricate — docs/19).
//
// Rule versioning is a documented simplification: rule key + version are
// constants in code rather than rows in a maker-checker-approved table,
// since that governance workflow needs an appointed clinical lead (OD-6)
// this pass doesn't have. Traceability (source/version/time/inputs) is
// still fully recorded per finding.

/// One evaluation run over a profile's current medications (docs/09).
/// Immutable once complete; a new trigger creates a new evaluation rather
/// than mutating a previous one.
model SafetyEvaluation {
  id               String         @id @default(uuid()) @db.Uuid
  patientProfileId String         @map("patient_profile_id") @db.Uuid
  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id])

  trigger       String
  appVersion    String    @map("app_version")
  /// Normalized medication/ingredient snapshot the rules ran against.
  inputSnapshot Json      @map("input_snapshot")
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)

  findings SafetyFinding[]

  @@index([patientProfileId, startedAt])
  @@map("safety_evaluations")
}

enum SafetyFindingSeverity {
  info
  low
  moderate
  high
}

enum SafetyFindingStatus {
  open
  acknowledged
  reviewed_with_professional
  resolved
}

/// A single concern from one evaluation (docs/09 traceability contract).
/// Acknowledging a finding never deletes it — see SafetyFindingAction.
model SafetyFinding {
  id               String           @id @default(uuid()) @db.Uuid
  evaluationId     String           @map("evaluation_id") @db.Uuid
  evaluation       SafetyEvaluation @relation(fields: [evaluationId], references: [id])
  /// Denormalized for direct querying without joining through evaluation.
  patientProfileId String           @map("patient_profile_id") @db.Uuid

  category       String
  severity       SafetyFindingSeverity
  /// patient_medication IDs involved, as text (not @db.Uuid — Prisma scalar
  /// lists don't support the uuid[] column type directly).
  medicationIds  String[]              @map("medication_ids")
  ruleKey        String                @map("rule_key")
  ruleVersion    String                @map("rule_version")
  sourceName     String                @map("source_name")
  /// Localization key for the plain-language summary.
  explanationKey String                @map("explanation_key")
  /// Structured detail (e.g. shared ingredient name) for rendering.
  detail         Json?

  status           SafetyFindingStatus @default(open)
  resolvedByUserId String?             @map("resolved_by_user_id") @db.Uuid
  resolvedAt       DateTime?           @map("resolved_at") @db.Timestamptz(6)
  evaluatedAt      DateTime            @default(now()) @map("evaluated_at") @db.Timestamptz(6)

  actions SafetyFindingAction[]

  @@index([patientProfileId, status])
  @@index([evaluationId])
  @@map("safety_findings")
}

enum SafetyFindingActionType {
  acknowledged
  note_added
  reviewed_with_professional
  resolved
}

/// Append-only action log per finding (docs/13) — the audit trail behind
/// SafetyFinding.status.
model SafetyFindingAction {
  id          String                  @id @default(uuid()) @db.Uuid
  findingId   String                  @map("finding_id") @db.Uuid
  finding     SafetyFinding           @relation(fields: [findingId], references: [id])
  action      SafetyFindingActionType
  note        String?
  actorUserId String                  @map("actor_user_id") @db.Uuid
  occurredAt  DateTime                @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@map("safety_finding_actions")
}

// ---------- sharing (Stage 7 subset of docs/13) ----------
//
// Scope this pass: QR/link sharing of a live-rendered doctor-visit summary.
// PDF generation (needs a server-side rendering engine, OD-14) and
// WhatsApp-text export are deferred. Shared content is never a frozen
// snapshot — it's re-aggregated from current data at each access (docs/12
// hazard H-12: a stale medication list shown to a doctor is a safety risk),
// so the same link keeps working correctly if the patient's medicines
// change between accesses, right up until it's expired or revoked.

/// What a patient opted to share and with which sections (docs/13).
/// Immutable once created — changing sections means creating a new share.
model SharePackage {
  id               String         @id @default(uuid()) @db.Uuid
  patientProfileId String         @map("patient_profile_id") @db.Uuid
  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id])

  /// { medications: true, allergies: true, conditions: true, recentChanges: true, concerns: true }
  sections        Json
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  links ShareLink[]

  @@map("share_packages")
}

enum ShareLinkKind {
  link
  qr
}

/// A specific access token for a share package (docs/13). The raw token is
/// shown to the patient once at creation and never stored — only its hash,
/// matching the session-token pattern (ADR-5).
model ShareLink {
  id             String       @id @default(uuid()) @db.Uuid
  sharePackageId String       @map("share_package_id") @db.Uuid
  sharePackage   SharePackage @relation(fields: [sharePackageId], references: [id])

  tokenHash       String        @unique @map("token_hash")
  kind            ShareLinkKind @default(link)
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime?     @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId String?       @map("revoked_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  accessEvents ShareAccessEvent[]

  @@map("share_links")
}

enum ShareAccessResult {
  success
  expired
  revoked
  not_found
}

/// Append-only, patient-visible access log (docs/13) — every attempt is
/// recorded, not just successful ones, so a patient can see probing too.
model ShareAccessEvent {
  id          String            @id @default(uuid()) @db.Uuid
  shareLinkId String            @map("share_link_id") @db.Uuid
  shareLink   ShareLink         @relation(fields: [shareLinkId], references: [id])
  result      ShareAccessResult
  ipDigest    String?           @map("ip_digest")
  accessedAt  DateTime          @default(now()) @map("accessed_at") @db.Timestamptz(6)

  @@index([shareLinkId, accessedAt])
  @@map("share_access_events")
}

// ---------- secure documents & OCR (Stage 3/8 subset of docs/13) ----------
//
// Object storage this pass: a local-disk adapter behind the same
// ObjectStorage interface as production R2 (docs/26, ADR-12) — this is a
// documented dev-only stand-in, not a substitute architecture; presigned
// upload/download, opaque keys, verification-before-trust, and audit-on-
// every-access all work the same way against either backend.
//
// OCR this pass: Tesseract.js (local, open-source, no API key) for English
// text extraction, feeding a deterministic (not AI-generated) extraction
// pass that matches against our own catalog and the frequency/pattern
// parser already built in Stage 4. AI-based content simplification/
// translation and Indic-script/handwriting OCR are not built — they need a
// provider decision (OD-11/12) this pass doesn't have. Extracted values are
// never clinically confirmed automatically — every field requires explicit
// per-field confirmation before it can back a medication (docs/09 §6).

enum StoredObjectBucket {
  patient_docs
  ocr_tmp
}

enum StoredObjectStatus {
  pending
  verified
  quarantined
  deleted
}

/// Every stored file, whichever backend actually holds the bytes (docs/13).
model StoredObject {
  id          String             @id @default(uuid()) @db.Uuid
  bucket      StoredObjectBucket
  /// Opaque, no patient identifiers (docs/13 §13.5): {kind}/{yyyy}/{mm}/{uuid}.
  objectKey   String             @unique @map("object_key")
  sha256      String?
  sizeBytes   Int?               @map("size_bytes")
  contentType String?            @map("content_type")
  status      StoredObjectStatus @default(pending)
  expiresAt   DateTime?          @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  document     PrescriptionDocument?
  accessEvents ObjectAccessEvent[]

  @@map("stored_objects")
}

enum ObjectAccessOperation {
  presign_upload
  presign_download
  stream
  delete
}

/// Append-only — every authorized access to a file, not just downloads.
model ObjectAccessEvent {
  id             String                @id @default(uuid()) @db.Uuid
  storedObjectId String                @map("stored_object_id") @db.Uuid
  storedObject   StoredObject          @relation(fields: [storedObjectId], references: [id])
  actorUserId    String?               @map("actor_user_id") @db.Uuid
  operation      ObjectAccessOperation
  occurredAt     DateTime              @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([storedObjectId, occurredAt])
  @@map("object_access_events")
}

enum DocumentKind {
  prescription
  strip
  box
  bottle
  discharge_summary
  other
}

enum DocumentStatus {
  pending_upload
  uploaded
  verified
  quarantined
  processing
  processed
  failed
  deleted
}

/// One uploaded prescription/strip/box/bottle photo (docs/13).
model PrescriptionDocument {
  id               String         @id @default(uuid()) @db.Uuid
  patientProfileId String         @map("patient_profile_id") @db.Uuid
  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id])
  storedObjectId   String         @unique @map("stored_object_id") @db.Uuid
  storedObject     StoredObject   @relation(fields: [storedObjectId], references: [id])
  kind             DocumentKind   @default(prescription)
  status           DocumentStatus @default(pending_upload)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  extractions PrescriptionExtraction[]

  @@index([patientProfileId])
  @@map("prescription_documents")
}

enum ExtractionStatus {
  queued
  running
  succeeded
  failed
}

/// One OCR + deterministic-extraction run over a document (docs/13).
/// Extracted text is never treated as clinically confirmed (docs/14.2) —
/// only the ExtractionCandidate confirmation flow can promote a value.
model PrescriptionExtraction {
  id                     String               @id @default(uuid()) @db.Uuid
  prescriptionDocumentId String               @map("prescription_document_id") @db.Uuid
  prescriptionDocument   PrescriptionDocument @relation(fields: [prescriptionDocumentId], references: [id])
  engine                 String
  engineVersion          String               @map("engine_version")
  status                 ExtractionStatus     @default(queued)
  /// Full raw OCR text, preserved verbatim for the "show original" view.
  rawText                String?              @map("raw_text")
  completedAt            DateTime?            @map("completed_at") @db.Timestamptz(6)
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  candidates ExtractionCandidate[]

  @@map("prescription_extractions")
}

enum ExtractionField {
  brand_name
  frequency
  food_instruction
}

enum CandidateStatus {
  proposed
  confirmed
  corrected
  rejected
}

/// One proposed field value (docs/09 §6 protocol): detected text, proposed
/// interpretation, confidence — always shown together, confirmation always
/// required, original always preserved even after correction.
model ExtractionCandidate {
  id                String                 @id @default(uuid()) @db.Uuid
  extractionId      String                 @map("extraction_id") @db.Uuid
  extraction        PrescriptionExtraction @relation(fields: [extractionId], references: [id])
  field             ExtractionField
  /// The exact OCR text this candidate was derived from — immutable.
  detectedText      String                 @map("detected_text")
  /// Machine-proposed plain-language interpretation (e.g. "1-0-1" → OD/BD/TDS + pattern).
  proposedValue     String?                @map("proposed_value")
  confidence        Decimal                @db.Decimal(4, 3)
  status            CandidateStatus        @default(proposed)
  confirmedValue    String?                @map("confirmed_value")
  confirmedByUserId String?                @map("confirmed_by_user_id") @db.Uuid
  confirmedAt       DateTime?              @map("confirmed_at") @db.Timestamptz(6)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("extraction_candidates")
}

// ---------- platform ----------

// background_jobs / dead_letter_jobs (docs/13): originally specced as a
// mirror of a BullMQ+Redis queue for auditability. There's no Redis in this
// sandbox (same constraint that made Stage 3/8's OCR and Stage 7's PDF
// rendering run synchronously in-request), so this pass makes Postgres the
// primary queue instead of just a mirror — a documented substitution, not a
// smaller feature: apps/worker claims rows via `SELECT ... FOR UPDATE SKIP
// LOCKED`, a standard, battle-tested Postgres queue pattern, and the API
// only ever enqueues + polls for a result.

enum BackgroundJobQueue {
  ocr_extraction
  pdf_render
}

enum BackgroundJobStatus {
  queued
  running
  succeeded
  failed
}

model BackgroundJob {
  id            String              @id @default(uuid()) @db.Uuid
  queue         BackgroundJobQueue
  /// Idempotency key — re-enqueueing the same logical job (e.g. the same
  /// document) reuses the row rather than creating a duplicate.
  jobKey        String              @unique @map("job_key")
  payload       Json
  status        BackgroundJobStatus @default(queued)
  attempts      Int                 @default(0)
  maxAttempts   Int                 @default(3) @map("max_attempts")
  correlationId String?             @map("correlation_id")
  result        Json?
  errorDigest   String?             @map("error_digest")
  lockedAt      DateTime?           @map("locked_at") @db.Timestamptz(6)
  lockedBy      String?             @map("locked_by")
  startedAt     DateTime?           @map("started_at") @db.Timestamptz(6)
  completedAt   DateTime?           @map("completed_at") @db.Timestamptz(6)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([queue, status, createdAt])
  @@map("background_jobs")
}

/// Permanently-failed jobs (attempts exhausted), kept for manual replay —
/// never silently dropped.
model DeadLetterJob {
  id            String             @id @default(uuid()) @db.Uuid
  queue         BackgroundJobQueue
  originalJobId String             @map("original_job_id") @db.Uuid
  payload       Json
  attempts      Int
  errorDigest   String             @map("error_digest")
  failedAt      DateTime           @default(now()) @map("failed_at") @db.Timestamptz(6)
  replayedAt    DateTime?          @map("replayed_at") @db.Timestamptz(6)

  @@map("dead_letter_jobs")
}

/// Server-side ledger of applied client mutations (offline idempotency).
model OfflineMutation {
  id               String   @id @default(uuid()) @db.Uuid
  clientMutationId String   @unique @map("client_mutation_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  patientProfileId String?  @map("patient_profile_id") @db.Uuid
  entity           String
  operation        String
  /// Digest of the applied result, used to answer idempotent replays.
  resultDigest     String?  @map("result_digest")
  resultBody       Json?    @map("result_body")
  appliedAt        DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@index([userId, appliedAt])
  @@map("offline_mutations")
}

/// Application-level rate limiting (docs/14/18/26 — "Cloudflare is never the
/// only protection"; this must stand alone). Fixed-window counter per
/// `key` (e.g. `otp_request:203.0.113.5`) + window start; originally specced
/// against Redis (`rate:` key namespace, docs/25) but there's no Redis in
/// this sandbox, so Postgres is the counter store instead — same documented
/// substitution as the background-job queue. `RateLimitGuard` upserts and
/// increments atomically via `ON CONFLICT DO UPDATE`, so concurrent requests
/// can never under-count.
model RateLimitBucket {
  id          String   @id @default(uuid()) @db.Uuid
  key         String
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int      @default(1)

  @@unique([key, windowStart])
  @@map("rate_limit_buckets")
}

enum AuditActorType {
  patient
  caregiver
  admin
  system
  share_visitor
}

enum BackupExecutionStatus {
  running
  succeeded
  failed
}

/// A daily pg_dump logical export, client-side encrypted before leaving
/// Postgres, uploaded to R2 (docs/27). `tableRowCounts` is captured at
/// export time so a later restore test has a manifest to check against
/// without needing the original database to still be in its old state.
model BackupExecution {
  id             String                @id @default(uuid()) @db.Uuid
  startedAt      DateTime              @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?             @map("completed_at") @db.Timestamptz(6)
  status         BackupExecutionStatus @default(running)
  objectKey      String?               @map("object_key")
  sizeBytes      Int?                  @map("size_bytes")
  sha256         String?
  tableRowCounts Json?                 @map("table_row_counts")
  errorDigest    String?               @map("error_digest")

  restoreTests RestoreTest[]

  @@map("backup_executions")
}

enum RestoreTestStatus {
  running
  passed
  failed
}

/// docs/27: "a backup without a passing restore test does not count toward
/// RPO" — this table is what makes that claim checkable rather than assumed.
model RestoreTest {
  id                String            @id @default(uuid()) @db.Uuid
  backupExecutionId String            @map("backup_execution_id") @db.Uuid
  backupExecution   BackupExecution   @relation(fields: [backupExecutionId], references: [id])
  startedAt         DateTime          @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime?         @map("completed_at") @db.Timestamptz(6)
  status            RestoreTestStatus @default(running)
  rowCountsMatch    Boolean?          @map("row_counts_match")
  detail            Json?
  errorDigest       String?           @map("error_digest")

  @@map("restore_tests")
}

/// Append-only, hash-chained audit log (docs/21). Rows are never updated.
model AuditEvent {
  id               String         @id @default(uuid()) @db.Uuid
  seq              BigInt         @default(autoincrement())
  actorUserId      String?        @map("actor_user_id") @db.Uuid
  actorType        AuditActorType @map("actor_type")
  action           String
  entityType       String?        @map("entity_type")
  entityId         String?        @map("entity_id") @db.Uuid
  patientProfileId String?        @map("patient_profile_id") @db.Uuid
  correlationId    String?        @map("correlation_id")
  /// Digests and coarse context only — never raw PHI values.
  context          Json?
  prevHash         String?        @map("prev_hash")
  rowHash          String         @map("row_hash")
  occurredAt       DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([patientProfileId, occurredAt])
  @@index([entityType, entityId])
  @@index([seq])
  @@map("audit_events")
}
